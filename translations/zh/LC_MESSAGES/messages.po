#: templates/index.html:6
msgid "AI Text Generator"
msgstr "AI文本生成器"

#: templates/index.html:17
msgid "Language"
msgstr "语言"

#: templates/index.html:26
msgid "Enter a keyword or phrase and let AI generate text for you"
msgstr "输入关键词或短语，让AI为您生成文本"

#: templates/index.html:28
msgid "This is an educational tool that demonstrates how machine learning models can generate text based on input prompts."
msgstr "这是一个教育工具，展示机器学习模型如何基于输入提示生成文本。"

#: templates/index.html:37
msgid "Input"
msgstr "输入"

#: templates/index.html:42
msgid "Enter a keyword or short sentence:"
msgstr "输入关键词或短句："

#: templates/index.html:44
msgid "Example: 'The future of technology'"
msgstr "示例：'科技的未来'"

#: templates/index.html:47
msgid "Generate Text"
msgstr "生成文本"

#: templates/index.html:60
msgid "Generated Text"
msgstr "生成的文本"

#: templates/index.html:62
msgid "Copy"
msgstr "复制"

#: templates/index.html:67
msgid "Generated text will appear here..."
msgstr "生成的文本将显示在这里..."

#: templates/index.html:79
msgid "How It Works"
msgstr "工作原理"

#: templates/index.html:86
msgid "1. Input Processing"
msgstr "1. 输入处理"

#: templates/index.html:87
msgid "Your input is tokenized (split into pieces that the model can understand) and preprocessed."
msgstr "您的输入被标记化（分割成模型可以理解的片段）并预处理。"

#: templates/index.html:94
msgid "2. Model Generation"
msgstr "2. 模型生成"

#: templates/index.html:95
msgid "A Markov chain text model finds patterns and generates coherent text based on your input."
msgstr "马尔可夫链文本模型找到模式并基于您的输入生成连贯的文本。"

#: templates/index.html:102
msgid "3. Text Output"
msgstr "3. 文本输出"

#: templates/index.html:103
msgid "The model's output is decoded back into human-readable text and displayed to you."
msgstr "模型的输出被解码回人类可读的文本并显示给您。"

#: templates/index.html:114
msgid "Educational Text Generation Project | Using Flask, Transformer & Markov Chain Models"
msgstr "教育文本生成项目 | 使用Flask、Transformer和马尔可夫链模型"

#: templates/index.html:120
msgid "Please enter a keyword or phrase."
msgstr "请输入关键词或短语。"

#: templates/index.html:121
msgid "Copied!"
msgstr "已复制！"

#: templates/index.html:122
msgid "Failed to copy text to clipboard"
msgstr "复制到剪贴板失败"

#: templates/index.html:123
msgid "An error occurred while generating text."
msgstr "生成文本时发生错误。"

#: templates/index.html:47
msgid "Select Model:"
msgstr "选择模型："

#: templates/index.html:49
msgid "Transformer (DistilGPT-2)"
msgstr "Transformer (DistilGPT-2)"

#: templates/index.html:50
msgid "Markov Chain"
msgstr "马尔可夫链"

#: templates/index.html:53
msgid "Transformer models generate more coherent text but may take longer."
msgstr "Transformer模型生成更连贯的文本，但可能需要更长时间。"
